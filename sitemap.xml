---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd" 
        xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Core Static Pages -->
  {% for page in site.pages %}
  {% unless page.url contains '.xml' or page.url contains '404' or page.url contains '.json' or page.url contains 'sw.' or page.url contains '/admin' or page.url contains '.txt' or page.url contains '.js' or page.sitemap == false %}
  <url>
    <loc>{{ site.url }}{{ page.url | replace: 'index.html', '' }}</loc>
    <changefreq>{% if page.url == '/' %}weekly{% elsif page.url contains 'product' %}weekly{% else %}monthly{% endif %}</changefreq>
    <priority>{% if page.url == '/' %}1.0{% elsif page.url contains 'product' %}0.9{% else %}0.7{% endif %}</priority>
  </url>
  {% endunless %}
  {% endfor %}

  <!-- Fleet & Products (Armada Mobil) -->
  {% for product in site.data-products %}
  <url>
    <loc>{{ site.url }}{{ product.url | replace: 'index.html', '' }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  {% endfor %}

  <!-- Blog Posts -->
  {% for post in site.posts %}
  <url>
    <loc>{{ site.url }}{{ post.url | replace: 'index.html', '' }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endfor %}
</urlset>